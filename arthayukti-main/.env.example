# Environment configuration for the ArthaYukti backend. Copy to backend/.env and edit.
# Never commit the real file.

# development and test may start without a secret (a temporary one is generated and sign-ins end
# on restart). Any other value, such as production, refuses to start without a strong SECRET_KEY.
ENVIRONMENT=development

# SQLite by default. For PostgreSQL: postgresql://user:password@localhost:5432/arthayukti
# Create or update the schema with:  cd backend && alembic upgrade head
DATABASE_URL=sqlite:///./arthayukti.db

# Required outside development. At least 32 random characters, for example:  openssl rand -hex 32
# Changing it signs everyone out.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of web addresses allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional development demo account. Off by default. It is only ever created when
# ENVIRONMENT=development, SEED_DEMO_USER=true and DEMO_USER_PASSWORD is at least 12 characters.
# Create it with:  cd backend && python -m app.db.init_db
SEED_DEMO_USER=false
DEMO_USER_PASSWORD=

# Password reset e-mail. "disabled" means the reset flow reports itself unavailable.
# Use "smtp" with the SMTP_* values below to turn it on.
MAIL_BACKEND=disabled
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:5173

# Limits
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BYTES=2000000

# Optional AI help in Plan B (Gemini). Get a key at https://aistudio.google.com/apikey and put it here only:
# it must never go in a VITE_* variable or any frontend file. Leave empty to turn the AI features off.
GEMINI_API_KEY=
# Change this if Google retires the model name. gemini-3.5-flash-lite was verified against a live key on 2026-10-26.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=1500

# Indian share prices. "yahoo" reads Yahoo Finance directly (unofficial, not for financial decisions).
# "indian_api" uses the Indian-Stock-Market-API service at MARKET_API_BASE_URL (the published address has not answered).
MARKET_PROVIDER=yahoo
# MARKET_API_BASE_URL=https://your-provider.example
# MARKET_API_TIMEOUT_SECONDS=8
